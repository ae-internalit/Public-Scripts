<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The excluded-apps picker only lists launchable apps, so a scoped
         <queries> declaration covers it. QUERY_ALL_PACKAGES is both broader
         than needed and a well-known Play Protect heuristic trigger. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Without these, MediaStore returns only images this app created, so the
         gallery, stitching and OCR never see system-captured screenshots. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Only API 28 needs this: there, read and write share one permission
         group, so the granted read also lets the gallery delete a file. From
         API 29 on, deletion goes through MediaStore's own confirmation. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ScreenshotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoubleTapScreenshot"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ExcludedAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.DoubleTapScreenshot" />

        <activity
            android:name=".BlurEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.DoubleTapScreenshot" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.DoubleTapScreenshot" />

        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.DoubleTapScreenshot" />

        <activity
            android:name=".ScreenRecordActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".DeleteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="screenshot_trigger_detection" />
        </service>

        <service
            android:name=".ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <activity
            android:name=".OcrActivity"
            android:exported="false"
            android:theme="@style/Theme.DoubleTapScreenshot" />

        <!-- Fetches the OCR model at install time so text extraction works on first use -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

    </application>

</manifest>
