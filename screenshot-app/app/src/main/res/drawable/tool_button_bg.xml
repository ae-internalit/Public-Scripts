<?xml version="1.0" encoding="utf-8"?>
<!-- The editor's tool buttons all shared one flat grey circle and nothing ever
     changed when a tool was picked, so the whole row read as disabled. This
     selector makes the active tool obvious. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF424242" />
        </shape>
    </item>
</selector>
