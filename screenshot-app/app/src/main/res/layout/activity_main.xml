<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleText" />

        <!-- Theme Card -->
        <TextView
            android:id="@+id/themeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/theme_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/subtitleText" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/themeLabel">

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_light"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_dark"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_system"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:buttonTint="@color/primary" />

        </RadioGroup>

        <!-- Status Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_background"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/themeGroup">

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/status_icon_desc"
                android:src="@drawable/ic_warning"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/orange" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/status_inactive"
                android:textColor="@color/orange"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/statusIcon"
                app:layout_constraintTop_toTopOf="@id/statusIcon" />

            <TextView
                android:id="@+id/screenshotCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/screenshot_count_zero"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/statusIcon"
                app:layout_constraintTop_toBottomOf="@id/statusText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/actionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="@string/button_enable"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/statusCard" />

        <Button
            android:id="@+id/pauseButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/card_background"
            android:enabled="false"
            android:text="@string/button_pause"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/actionButton"
            app:strokeColor="@color/text_secondary"
            app:strokeWidth="1dp" />

        <!-- Trigger Method -->
        <TextView
            android:id="@+id/triggerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/trigger_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/pauseButton" />

        <RadioGroup
            android:id="@+id/triggerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/triggerLabel">

            <RadioButton
                android:id="@+id/triggerDoubleTap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/trigger_double_tap"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/triggerShake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/trigger_shake"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

        </RadioGroup>

        <!-- Smart Features -->
        <TextView
            android:id="@+id/smartFeaturesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/smart_features_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/triggerGroup" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/smartKeyboardCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/smartFeaturesLabel">

            <TextView
                android:id="@+id/smartKeyboardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/smart_keyboard_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/smartKeyboardSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/smartKeyboardDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:text="@string/smart_keyboard_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/smartKeyboardSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/smartKeyboardTitle" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/smartKeyboardSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/primary"
                app:trackTint="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Quick Share Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/quickShareCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/smartKeyboardCard">

            <TextView
                android:id="@+id/quickShareTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/quick_share_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/quickShareSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/quickShareDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:text="@string/quick_share_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/quickShareSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/quickShareTitle" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/quickShareSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/primary"
                app:trackTint="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Auto-Rename Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/autoRenameCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/quickShareCard">

            <TextView
                android:id="@+id/autoRenameTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/auto_rename_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/autoRenameSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/autoRenameDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:text="@string/auto_rename_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/autoRenameSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/autoRenameTitle" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoRenameSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:thumbTint="@color/primary"
                app:trackTint="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Watermark Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/watermarkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/autoRenameCard">

            <TextView
                android:id="@+id/watermarkTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/watermark_switch_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/watermarkSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/watermarkDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:text="@string/watermark_switch_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/watermarkSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/watermarkTitle" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/watermarkSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:thumbTint="@color/primary"
                app:trackTint="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/watermarkTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:hint="@string/watermark_hint"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/watermarkDesc" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/excludedAppsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:gravity="start|center_vertical"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/excluded_apps_button"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/watermarkCard" />

        <!-- History & Recording -->
        <Button
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:gravity="start|center_vertical"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/history_button"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/excludedAppsButton" />

        <Button
            android:id="@+id/recordButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:gravity="start|center_vertical"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/record_start"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/historyButton" />

        <!-- Sensitivity Card -->
        <TextView
            android:id="@+id/sensitivityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/sensitivity_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/recordButton" />

        <RadioGroup
            android:id="@+id/sensitivityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/sensitivityLabel">

            <RadioButton
                android:id="@+id/sensitivityFast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/sensitivity_fast"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/sensitivityNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/sensitivity_normal"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/sensitivitySlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/sensitivity_slow"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

        </RadioGroup>

        <!-- Tap Count Section -->
        <TextView
            android:id="@+id/tapCountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/tap_count_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/sensitivityGroup" />

        <RadioGroup
            android:id="@+id/tapCountGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tapCountLabel">

            <RadioButton
                android:id="@+id/tapCountDouble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/tap_count_double"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/tapCountTriple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/tap_count_triple"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

        </RadioGroup>

        <!-- Delay Section -->
        <TextView
            android:id="@+id/delayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/delay_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tapCountGroup" />

        <RadioGroup
            android:id="@+id/delayGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/delayLabel">

            <RadioButton
                android:id="@+id/delayNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/delay_none"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/delay3s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/delay_3s"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/delay5s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/delay_5s"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

        </RadioGroup>

        <!-- Vibration Section -->
        <TextView
            android:id="@+id/vibrationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/vibration_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/delayGroup" />

        <RadioGroup
            android:id="@+id/vibrationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/vibrationLabel">

            <RadioButton
                android:id="@+id/vibrationNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/vibration_none"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/vibrationShort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/vibration_short"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/vibrationLong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/vibration_long"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/vibrationDouble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/vibration_double"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/primary" />

        </RadioGroup>

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/instruction_setup"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/vibrationGroup" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
