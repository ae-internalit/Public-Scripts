<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_background">

    <LinearLayout
        android:id="@+id/viewerTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnViewerBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/viewer_chrome"
            android:text="@string/viewer_back"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/viewerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <com.doubletap.screenshot.ZoomableImageView
        android:id="@+id/viewerImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/viewer_image_description"
        app:layout_constraintBottom_toTopOf="@id/viewerActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewerTopBar" />

    <ProgressBar
        android:id="@+id/viewerProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/viewerImage"
        app:layout_constraintEnd_toEndOf="@id/viewerImage"
        app:layout_constraintStart_toStartOf="@id/viewerImage"
        app:layout_constraintTop_toTopOf="@id/viewerImage" />

    <LinearLayout
        android:id="@+id/viewerActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/viewer_chrome"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnViewerOcr"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="@string/viewer_copy_text"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnViewerEdit"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/viewer_button"
            android:text="@string/viewer_edit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnViewerShare"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/viewer_button"
            android:text="@string/viewer_share"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnViewerDelete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/danger"
            android:text="@string/viewer_delete"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
