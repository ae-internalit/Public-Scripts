<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <TextView
        android:id="@+id/blurTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/editor_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/toolIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tool_blur"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/blurTitle" />

    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toTopOf="@id/toolBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolIndicator">

        <ImageView
            android:id="@+id/editorImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <com.doubletap.screenshot.BlurOverlayView
            android:id="@+id/blurOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/buttonBar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btnToolBlur"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_blur"
                android:padding="10dp"
                android:src="@drawable/ic_blur" />

            <ImageButton
                android:id="@+id/btnToolDraw"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_draw"
                android:padding="10dp"
                android:src="@drawable/ic_draw" />

            <ImageButton
                android:id="@+id/btnToolArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_arrow"
                android:padding="10dp"
                android:src="@drawable/ic_arrow" />

            <ImageButton
                android:id="@+id/btnToolText"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_text"
                android:padding="10dp"
                android:src="@drawable/ic_text" />

            <ImageButton
                android:id="@+id/btnToolCrop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_crop"
                android:padding="10dp"
                android:src="@drawable/ic_crop" />

            <ImageButton
                android:id="@+id/btnToolWatermark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_watermark"
                android:padding="10dp"
                android:src="@drawable/ic_watermark" />

            <ImageButton
                android:id="@+id/btnToolOcr"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_ocr"
                android:padding="10dp"
                android:src="@drawable/ic_ocr" />

            <ImageButton
                android:id="@+id/btnToolFilter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_filter"
                android:padding="10dp"
                android:src="@drawable/ic_filter" />

            <ImageButton
                android:id="@+id/btnToolRotate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_rotate"
                android:padding="10dp"
                android:src="@drawable/ic_rotate" />

            <ImageButton
                android:id="@+id/btnToolUndo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/tool_undo"
                android:padding="10dp"
                android:src="@drawable/ic_undo" />

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/buttonBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/card_background"
            android:text="@string/blur_cancel"
            android:textColor="@color/text_secondary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/text_secondary"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="@string/blur_save"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnShareBlurred"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/green"
            android:text="@string/blur_share"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
